<?xml version="1.0" encoding="utf-8"?>
<!--
  OxygenOS / OnePlus device settings layout, matching the user's screenshot:
  1. Top bar with back button and dev tools.
  2. Large blue circular icon badge (#007AFF) with headphone/grid glyph.
  3. Prominent bold device name ("Aman's OnePlus Nord Buds") and "Connected" subtitle.
  4. 3D animated showcase of earbuds and pebble case.
  5. Exact screenshot horseshoe battery gauge arcs (Left 100%, Case 70%, Right 100%).
  6. Clean noise control card (Noise cancellation, Off, Transparency).
  7. Spacious grouped feature cards.
  8. Floating action capsule at the bottom: [ Rename / Model ]  [ Disconnect / Connect ]  [ Settings ].
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appColorBg">

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="96dp">

            <!-- Top Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chevron_right"
                    android:rotation="180"
                    android:tint="?attr/appColorTextPrimary"
                    android:contentDescription="@string/dialog_close" />

                <TextView
                    android:id="@+id/headerTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true" />

                <ImageButton
                    android:id="@+id/btnModel"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_model_list"
                    android:tint="?attr/appColorTextSecondary"
                    android:contentDescription="@string/model_title" />

                <ImageButton
                    android:id="@+id/btnDevTools"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_dev_tools"
                    android:tint="?attr/appColorTextSecondary"
                    android:contentDescription="@string/action_dev_tools" />

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_settings_cog"
                    android:tint="?attr/appColorTextSecondary"
                    android:contentDescription="@string/action_settings" />
            </LinearLayout>

            <!-- OxygenOS Blue Circular Badge (exact match to screenshot) -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_bg"
                    android:tint="#007AFF" />

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_model_list"
                    android:tint="#FFFFFF" />
            </FrameLayout>

            <!-- Device Title (e.g. Aman's OnePlus Nord Buds) -->
            <TextView
                android:id="@+id/deviceNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/default_device_name"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:textColor="?attr/appColorTextPrimary" />

            <!-- Connection Status Subtitle (exact match to screenshot) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/connDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_status_dot_filled"
                    android:tint="#10B981"
                    android:contentDescription="@string/conn_status_desc" />

                <TextView
                    android:id="@+id/connText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/conn_on"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif"
                    android:textColor="?attr/appColorTextSecondary" />
            </LinearLayout>

            <!-- Tile 1: 3D Earbuds & Case + Horseshoe Battery Gauges -->
            <include layout="@layout/tile_battery" />

            <!-- Tile 2: Noise Control (Noise cancellation, Off, Transparency) -->
            <include layout="@layout/tile_noise" />

            <!-- Tile 3: Grouped Feature Settings -->
            <include layout="@layout/tile_settings" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Floating Action Bar / Capsule (exact match to screenshot) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="54dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:elevation="12dp"
        android:background="@drawable/widget_bg"
        android:backgroundTint="?attr/appColorCard">

        <!-- Rename / Model Button -->
        <LinearLayout
            android:id="@+id/bottomModel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_pencil"
                android:tint="?attr/appColorTextPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rename"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:textColor="?attr/appColorTextPrimary" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="?attr/appColorOutline"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <!-- Disconnect / Connect Button -->
        <LinearLayout
            android:id="@+id/connPill"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_power"
                android:tint="?attr/appColorTextPrimary" />

            <TextView
                android:id="@+id/connActionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disconnect"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:textColor="?attr/appColorTextPrimary" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="?attr/appColorOutline"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <!-- Settings Button -->
        <LinearLayout
            android:id="@+id/bottomSettings"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_settings_cog"
                android:tint="?attr/appColorTextPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:textColor="?attr/appColorTextPrimary" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
